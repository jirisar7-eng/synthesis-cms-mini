{
  "name": "synthesis-cms-mini",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": "10.9.9"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "mysql2": "^3.24.0",
    "deepmerge-ts": "^8.0.0"
  }
}
