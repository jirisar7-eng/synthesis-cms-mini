{
  "name": "synthesis-cms-mini",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "workspaces": [
    "apps/*",
    "core/*",
    "contracts/*",
    "sdk/*",
    "modules/*",
    "project-packs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test",
    "verify": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
