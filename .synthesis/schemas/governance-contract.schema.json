{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthesis-cms-mini.org/schemas/governance-contract.schema.json",
  "title": "Synthesis CMS mini Governance Contract Schema",
  "description": "Formal schema for versioned, immutable governance contract snapshots supporting multi-version tracking and explicit supersession.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "contract_id",
    "contract_version",
    "title",
    "lifecycle_state",
    "effective_from_step",
    "authority_domain",
    "scope",
    "invariants",
    "provisions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_kind": {
      "type": "string",
      "const": "GOVERNANCE_CONTRACT_SNAPSHOT"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^CONTRACT-[A-Z0-9-]+$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VERSIONED",
        "LOCKED",
        "ACTIVE",
        "SUPERSEDED"
      ]
    },
    "effective_from_step": {
      "type": "string"
    },
    "authority_domain": {
      "type": "string",
      "enum": [
        "GOVERNANCE",
        "CORE",
        "MODULE_RUNTIME",
        "DATABASE",
        "SECURITY"
      ]
    },
    "scope": {
      "type": "string"
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "statement",
          "enforcement"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "enforcement": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  }
}
