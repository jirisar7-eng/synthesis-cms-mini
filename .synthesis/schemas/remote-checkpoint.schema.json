{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthesis CMS Mini Remote File Checkpoint Schema",
  "description": "Cryptographically verifiable schema for immutable remote file checkpoints.",
  "type": "object",
  "required": [
    "payload",
    "seal"
  ],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "schema_version",
        "record_kind",
        "checkpoint_id",
        "checkpoint_type",
        "checkpoint_state",
        "task_id",
        "command_id",
        "project_id",
        "roadmap_step",
        "repository",
        "target_commit",
        "remote_verification",
        "checkpoint_lineage",
        "checkpointed_files",
        "evidence_binding",
        "recovery_semantics"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "record_kind": {
          "type": "string",
          "const": "REMOTE_FILE_CHECKPOINT"
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^CHK-[A-Z0-9_-]+-[0-9]{8}-[0-9]{3}$"
        },
        "checkpoint_type": {
          "type": "string",
          "enum": [
            "SINGLE_FILE",
            "ATOMIC_GROUP"
          ]
        },
        "checkpoint_state": {
          "type": "string",
          "const": "CHECKPOINT_COMPLETE"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "project_id": {
          "type": "string",
          "const": "SYNTHESIS_CMS_MINI"
        },
        "roadmap_step": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "object",
          "required": [
            "name",
            "id",
            "branch",
            "base_main_sha"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "const": "jirisar7-eng/synthesis-cms-mini"
            },
            "id": {
              "type": "integer",
              "const": 1401215700
            },
            "branch": {
              "type": "string",
              "pattern": "^(task/[A-Z0-9_-]+|main)$"
            },
            "base_main_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "target_commit": {
          "type": "object",
          "required": [
            "commit_sha",
            "parent_sha",
            "commit_timestamp_utc"
          ],
          "additionalProperties": false,
          "properties": {
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "parent_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "commit_timestamp_utc": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "remote_verification": {
          "type": "object",
          "required": [
            "verification_method",
            "observed_remote_ref",
            "observed_remote_sha",
            "remote_relationship",
            "verified_at_utc"
          ],
          "additionalProperties": false,
          "properties": {
            "verification_method": {
              "type": "string",
              "enum": [
                "GIT_LS_REMOTE",
                "GITHUB_REST_API"
              ]
            },
            "observed_remote_ref": {
              "type": "string",
              "minLength": 1
            },
            "observed_remote_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "remote_relationship": {
              "type": "string",
              "enum": [
                "EXACT_HEAD",
                "VERIFIED_DESCENDANT"
              ]
            },
            "verified_at_utc": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "checkpoint_lineage": {
          "type": "object",
          "required": [
            "parent_checkpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "parent_checkpoint": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "checkpoint_id",
                "file_path",
                "raw_file_sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpoint_id": {
                  "type": "string",
                  "pattern": "^CHK-[A-Z0-9_-]+-[0-9]{8}-[0-9]{3}$"
                },
                "file_path": {
                  "type": "string",
                  "pattern": "^\\.synthesis/checkpoints/CHK-[A-Z0-9_-]+-[0-9]{8}-[0-9]{3}\\.json$"
                },
                "raw_file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "checkpointed_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file_path",
              "operation",
              "source_blob_sha",
              "result_blob_sha",
              "file_size_bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "file_path": {
                "type": "string",
                "pattern": "^(?!\\.synthesis/(checkpoints|task-capsules|attestations)/)[a-zA-Z0-9._/-]+$"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "ADD",
                  "MODIFY"
                ]
              },
              "source_blob_sha": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              },
              "result_blob_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "file_size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "evidence_binding": {
          "type": "object",
          "required": [
            "linked_capsule_id",
            "linked_capsule_payload_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "linked_capsule_id": {
              "type": "string",
              "pattern": "^CAP-[A-Z0-9_-]+$"
            },
            "linked_capsule_payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "recovery_semantics": {
          "type": "object",
          "required": [
            "durability_state",
            "skippable_on_recovery"
          ],
          "additionalProperties": false,
          "properties": {
            "durability_state": {
              "type": "string",
              "const": "REMOTE_DURABLE"
            },
            "skippable_on_recovery": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "required": [
        "status",
        "hash_algorithm",
        "canonicalization_algorithm",
        "payload_sha256",
        "sealed_at",
        "sealed_by",
        "seal_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "const": "SEALED"
        },
        "hash_algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "canonicalization_algorithm": {
          "type": "string",
          "const": "RFC-8785"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        },
        "sealed_by": {
          "type": "string",
          "minLength": 1
        },
        "seal_signature": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
