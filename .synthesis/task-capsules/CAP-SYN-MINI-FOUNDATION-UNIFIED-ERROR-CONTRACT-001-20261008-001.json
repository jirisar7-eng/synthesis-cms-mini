          "discovery_summary": {
            "objective": "Establish a standardized, unified error contract across Synthesis CMS mini Core, Contracts, Runtimes, Modules, and API responses.",
            "error_handling_necessity": "Without a unified error contract, modules and services throw heterogeneous, untyped errors, exposing stack traces or raw internal exceptions to public clients."
          },
          "error_contract_specification": {
            "contract_id": "CONTRACT-CORE-UNIFIED-ERROR-001",
            "version": "1.0.0",
            "error_kinds": [
              "DOMAIN_ERROR",
              "SYSTEM_ERROR",
              "SECURITY_ERROR",
              "VALIDATION_ERROR",
              "GOVERNANCE_ERROR",
              "MODULE_ERROR",
              "INTEGRATION_ERROR",
              "LICENSE_ERROR",
              "INFRASTRUCTURE_ERROR"
            ],
            "severity_levels": [
              "FATAL",
              "ERROR",
              "WARNING",
              "INFO"
            ],
            "canonical_payload_fields": [
              "code",
              "message",
              "kind",
              "severity",
              "http_status",
              "details",
              "correlation_id",
              "timestamp",
              "recoverable"
            ],
            "code_formatting_rule": "UPPERCASE_SNAKE_CASE prefixed with ERR_"
          },
          "security_and_privacy_invariants": [
            "INV-ERROR-NO-STACK-LEAK: Stack traces and internal frame details must never be serialized into public/client error payloads.",
            "INV-ERROR-NO-SECRET-LEAK: DB credentials, JWT tokens, private keys, and internal system paths must be stripped before error emission.",
            "INV-ERROR-STRICT-TYPING: All system and module errors must derive from or serialize to Unified Error Contract format.",
            "INV-ERROR-FAIL-CLOSED: Unhandled internal exceptions map to ERR_INTERNAL_SERVER_ERROR (HTTP 500) with sanitized client message."
          ],
